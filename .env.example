# Copy to .env and fill in. Never commit .env.
# --- secrets -------------------------------------------------------------
POSTGRES_USER=aibrarian
POSTGRES_PASSWORD=change-me
JELLYFIN_API_KEY=                 # Jellyfin > Dashboard > API Keys
GOOGLE_BOOKS_API_KEY=             # optional, only used with AIB_GOOGLE_BOOKS_ENABLED=true
AIB_GOOGLE_BOOKS_ENABLED=false    # Open Library index is the reference; Google Books off

# --- host paths (defaults match z8g4) ----------------------------------
MEDIA_HOST_ROOT=/opt/jellyfin/media
CALIBRE_HOST_DIR=/opt/calibre/books
ABS_HOST_ROOT=/opt/audiobookshelf
AIB_DATA_HOST_DIR=/opt/stacks/aibrarian/data
OPENLIBRARY_HOST_DIR=/opt/stacks/ai/openlibrary
AIB_UID=1000                      # owner of the media files (id -u)
AIB_GID=1000

# --- endpoints -----------------------------------------------------------
JELLYFIN_URL=http://host.docker.internal:8096
PREFECT_UI_API_URL=http://z8g4:4200/api

# --- behaviour -----------------------------------------------------------
AIB_TRANSCRIBE_ROOTS=01-movies,02-tvshows,05-instructional_videos
AIB_LIBRARY_ROOTS=01-movies,02-tvshows,03-music,downloads
AIB_TRANSCRIBE_BATCH_SIZE=5
AIB_TRANSCRIBE_INTERVAL_S=300
AIB_WHISPER_MODEL=large-v3
AIB_BOOK_MODE=suggest             # suggest | auto
AIB_BOOK_MIN_CONFIDENCE=0.85
AIB_BOOK_REVIEW_CONFIDENCE=0.60
# duplicate quarantine root (container path; dated subfolders are created inside).
# Keep it under /media (same filesystem) so moves are instant renames.
QUARANTINE_DIR=/media/_quarantine
QUARANTINE_RETENTION_DAYS=30      # quarantine-purge (daily 04:37 UTC) deletes copies older than this
DEDUP_AUTO_ENABLED=true           # dedup-quarantine (Sundays 05:00 UTC) on/off
DEDUP_BATCH_LIMIT=50              # extra copies moved per weekly run; 0 = unlimited
BOOK_AUTO_APPLY_ENABLED=true      # book-autoapply (hourly :50 UTC) on/off
BOOK_AUTO_BATCH_LIMIT=50          # book suggestions per run; 0 = unlimited
BOOK_AUTO_MIN_CONFIDENCE=0.90     # 0-1 evidence score; below -> needs_review, file untouched
CALIBREDB=calibredb               # calibre CLI inside the image (/opt/calibre)
TZ=UTC

# --- devtools profile ------------------------------------------------------
CGR_MODEL=qwen3:14b

# --- devtools: Code-Graph-RAG MCP token (required for LAN access) ---
MCP_HTTP_AUTH_TOKEN=

# Open Library Delta Lake (host, mounted read-only) and the local lookup index (container path)
OL_DELTA_HOST_DIR=/opt/openlibrary/delta
OL_INDEX_PATH=/data/olindex/openlibrary.sqlite
AIB_PROGRESS_LOG_SECONDS=900
